# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
kdy-addon/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Windows reserved names workaround
nul

# Claude Code 임시 파일
tmpclaude-*

# 디버그/임시 파일
debug_*.png
output.csv

# Python
__pycache__/
*.pyc
.venv/
.python-version

# 기타
*.csv
project_structure.txt
supabase/.temp/

# kdydispatch — 프로젝트 한정 분산 상태
.dispatch/
!.dispatch/.gitkeep

# kdyswarm — 워크트리 병렬 실행 임시 상태
.kdyswarm/

# Claude Code Agent 워크트리 (isolation:worktree 임시 격리)
.claude/worktrees/
